# ============================================================
# KUBO VIBE DEV — Edge Function Secrets template
# ============================================================
# These are the secrets consumed by edge functions in
# `supabase/functions/*`. They are NOT stored in this file in
# production — they live in Lovable Cloud Secrets and are
# injected at runtime via `Deno.env.get("NAME")`.
#
# This file is a REFERENCE: it documents every secret used by
# the project and where to obtain it.
#
# Local dev with `supabase functions serve`:
#   cp supabase/functions/.env.example supabase/functions/.env
#   supabase functions serve --env-file ./supabase/functions/.env
#
# ⚠️  NEVER commit a real `.env` with filled values.
# ============================================================


# ─── Core Supabase (auto-provisioned by Lovable Cloud) ──────
# Dashboard → Project Settings → API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."  # ⚠️ NEVER expose client-side
SUPABASE_DB_URL="postgres://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres"
SUPABASE_JWKS=""                                      # JSON web key set (auto)


# ─── AI Providers ───────────────────────────────────────────
# Lovable AI Gateway (preferred — no key needed for managed)
LOVABLE_API_KEY="lvb_..."

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# DeepSeek (heavy code gen) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk-..."

# Moonshot / Kimi (light tasks) — https://platform.moonshot.cn
KIMI_API_KEY="sk-..."

# Groq — https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Bytez (multimodal) — https://bytez.com
BYTEZ_API_KEY="..."

# Suno (music generation) — https://suno.ai
SUNO_API_KEY="..."


# ─── Scraping / Cloning ─────────────────────────────────────
# Firecrawl — https://firecrawl.dev/app/api-keys
# (managed by Lovable Connector — edit via Connectors panel)
FIRECRAWL_API_KEY="fc-..."


# ─── Payments ───────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."            # or sk_test_
STRIPE_WEBHOOK_SECRET="whsec_..."          # Dashboard → Webhooks → endpoint

# Polar.sh — https://polar.sh/dashboard/settings
POLAR_ACCESS_TOKEN="polar_..."


# ─── GitHub OAuth (Connectors) ──────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID="Iv1.xxxxxxxxxxxxxxxx"
GITHUB_CLIENT_SECRET="ghs_..."


# ─── Gmail OAuth (Connectors) ───────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
GMAIL_OAUTH_CLIENT_ID="xxx.apps.googleusercontent.com"
GMAIL_OAUTH_CLIENT_SECRET="GOCSPX-..."


# ─── Slack (Connector) ──────────────────────────────────────
# (managed by Lovable Connector — edit via Connectors panel)
SLACK_API_KEY="xoxb-..."


# ─── Web3 / Blockchain ──────────────────────────────────────
# Pinata (IPFS) — https://app.pinata.cloud/developers/api-keys
PINATA_JWT="eyJhbGciOiJIUzI1NiIs..."

# RPC + deployer (Sepolia testnet)
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/<project-id>"
DEPLOYER_PRIVATE_KEY="0x..."  # ⚠️ Test wallet only — NEVER mainnet keys


# ─── Domains / DNS ──────────────────────────────────────────
# IONOS — https://developer.hosting.ionos.com
IONOS_API_KEY="..."
IONOS_API_PREFIX="..."


# ─── Connector encryption ───────────────────────────────────
# 32-byte base64 key used to encrypt stored connector credentials.
# Generate: openssl rand -base64 32
CONNECTOR_ENC_KEY="base64-32-bytes..."


# ─── Test infrastructure ────────────────────────────────────
# Shared secret used by RLS realtime test (src/test/realtime-rls.test.ts)
# and the rls-test-create-user edge function.
RLS_TEST_SECRET="random-long-string"
