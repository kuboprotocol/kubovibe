# Template — Secrets do workflow `rerun-concurrency`
# ⚠️  NÃO commitar valores reais. Copie para `.env.rerun-ci` (gitignored) ou cole em GitHub Secrets.

# Endpoint do projeto Lovable Cloud (Supabase)
# Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL="https://<project-ref>.supabase.co"

# service_role key (NUNCA exponha no frontend / repositório público)
# Supabase Dashboard → Project Settings → API → service_role → Reveal
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# JWT de um usuário de teste autenticado (logue na app e copie o access_token)
# DevTools → Application → Local Storage → sb-<ref>-auth-token → access_token
RERUN_TEST_ACCESS_TOKEN="eyJhbGciOiJIUzI1NiIs..."

# UUID de um `creative_assets` existente pertencente ao usuário de teste acima
# SQL: select id from public.creative_assets where user_id = '<uuid>' limit 1;
RERUN_TEST_ASSET_ID="00000000-0000-0000-0000-000000000000"

# (Repository Variable, não secret) — ativa o workflow em push/PR
# RERUN_CONCURRENCY_ENABLED=true
